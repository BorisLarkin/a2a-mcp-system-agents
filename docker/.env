# Настройки сети
COMPUTER_A_IP=192.168.196.80
COMPUTER_B_IP=192.168.196.9

# Безопасность
API_KEY_DEV=dev_test_key_123

# Общие настройки
COMPOSE_PROJECT_NAME=mcp-ai
ENVIRONMENT=development
LOG_LEVEL=info

# Сеть
NETWORK_NAME=mcp-ai-network
NETWORK_DRIVER=bridge

# Агенты
AGENT_PORT=8080

# Classifier Agent
CLASSIFIER_PORT=9001
CLASSIFIER_NAME=classifier-v1
CLASSIFIER_TYPE=classifier

# Researcher Agent
RESEARCHER_PORT=9002
RESEARCHER_NAME=researcher-v1
RESEARCHER_TYPE=researcher
RESEARCHER_ENABLE_SEARCH=false

# Generator Agent
GENERATOR_PORT=9003
GENERATOR_NAME=generator-v1
GENERATOR_TYPE=generator
GENERATOR_MODEL=llama3.2
GENERATOR_TEMPERATURE=0.7
GENERATOR_MAX_TOKENS=500

# MCP Tools
RUBERT_PORT=9100
RUBERT_NAME=rubert-tiny2
RUBERT_CLASSES=5

ENCODER_PORT=9102
ENCODER_NAME=paraphrase-multilingual-MiniLM-L12-v2

# Redis
REDIS_PORT=6379
REDIS_DATA=redis-data

# Ollama (если нужен)
OLLAMA_HOST=ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MODEL_TAG=llama3.2:latest